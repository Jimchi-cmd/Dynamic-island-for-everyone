{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Islet",
  "version": "0.2.0",
  "identifier": "app.islet.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Islet Settings",
        "width": 760,
        "height": 580,
        "minWidth": 620,
        "minHeight": 480,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A Dynamic Island-style overlay",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "Islet puts music, device battery, navigation ETA and more in a smooth pill at the top of your screen. Lightweight enough for low-end laptops.",
    "copyright": "\u00a9 Islet contributors. MIT License.",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "depends": [],
        "recommends": [
          "libsecret-tools"
        ]
      },
      "rpm": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "mainBinaryName": "islet-settings"
}
